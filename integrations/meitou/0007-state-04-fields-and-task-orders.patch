+/// same numbering, but eight of its symbol names differ (0, 38, 52, 65, 223, 245, 289, 290), so an order's type is looked up here by number and
+/// never spelled from the Meitou enum. 0 (<c>NULL_TASK</c>) is no order and maps to null, as does any number outside the table.
+/// </summary>
+internal static class OracleTaskNames
+{
+    internal const int Count = 291;
+
+    /// <summary>The native name of task row <paramref name="row"/>, else null.</summary>
+    internal static string? Of(int row) => (uint)row < (uint)Names.Length ? Names[row] : null;
+
+    static readonly string?[] Names =
+    [
+        /*   0 */ null,
+        /*   1 */ "move_on_free_will",
+        /*   2 */ "build",
+        /*   3 */ "pickup",
+        /*   4 */ "melee_attack",
+        /*   5 */ "focused_melee_attack",
+        /*   6 */ "equip_weapon",
