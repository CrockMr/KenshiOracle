diff --git a/src/Meitou.Game/GameHost.Oracle.cs b/src/Meitou.Game/GameHost.Oracle.cs
new file mode 100644
index 00000000..1614f318
--- /dev/null
+++ b/src/Meitou.Game/GameHost.Oracle.cs
@@ -0,0 +1,540 @@
+using System.Globalization;
+using System.Numerics;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Meitou.Data.Save;
+using Meitou.Data.World;
+using Meitou.Engine;
+using Meitou.Engine.Cameras;
+using Meitou.Game.Oracle;
+using Meitou.Simulation;
+using Meitou.Simulation.Saving;
+
+namespace Meitou.Game;
+
+/// <summary>The opt-in oracle is serviced between world ticks. Its network workers never receive a world or actor.</summary>
+sealed partial class GameHost
+{
+    OracleServer? oracleServer;
+    OracleState? oracleState;
+    readonly string oracleInstance = g.Oracle ? Guid.NewGuid().ToString("N") : "";
+    string oracleOutput = "", oracleSaveRoot = "";
+    ulong oracleSeed;
+    string oracleSeedSource = "default";
+    bool oracleSeedApplied, oracleLoadPending;
+    string? oracleLoadError;
+    long oracleFrame;
+    double? oracleSelectedSpeed;
+    bool oracleEdgeOwned;
+    bool? oracleEdgeSetting;
+    Vector3 oracleFollowOffset;
+    bool oracleFollowRestored;
+    OracleControl? oraclePreparedControl;
+    string? oracleControlToken;
+    int oracleControlEpoch;
+    OracleRun? oracleRun;
+
+    sealed class OracleHostError(string code, string message) : Exception(message)
+    {
+        public string Code { get; } = code;
+    }
+
+    sealed record OracleControl(Vector3 Center, Vector4 Orientation, float Zoom, bool Free, bool Edge,
+        double Speed, bool Paused, string? Follow);
+    sealed class OracleRun(string id, double target, double deadline, int epoch)
+    {
+        public string Id { get; } = id;
+        public double Target { get; } = target;
+        public double Deadline { get; } = deadline;
+        public int Epoch { get; } = epoch;
+        public string Status { get; set; } = "running";
+    }
+
+    void StartOracle()
+    {
+        if (!g.Oracle) return;
+        oracleSeed = g.Seed;
+        oracleSeedSource = g.SeedGiven ? "command_line" : "oracle_default";
+        oracleOutput = Path.GetFullPath(g.OracleOutput ?? "oracle-dumps");
+        oracleSaveRoot = g.Load is { } folder
+            ? Path.GetDirectoryName(Path.TrimEndingDirectorySeparator(Path.GetFullPath(folder)))!
+            : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "kenshi", "save");
+        oracleLoadPending = g.Load is not null;
+        oracleState = new OracleState();
+        oracleServer = new OracleServer(g.OraclePort);
+        oracleServer.PublishHeartbeat(new { frame = 0, timestamp_ms = 0, service_frame = 0,
+            service_timestamp_ms = 0, service_thread = 0, game_thread = 0, loading = true });
+        Console.WriteLine($"[MeitouOracle] loopback port {oracleServer.LocalPort}; seed {oracleSeed}; output {oracleOutput}");
+    }
+
+    // Called before SaveLoader.Load and its first random draws, on this load's private in-memory SaveGame only.
+    void ApplyOracleSeed(SaveGame save)
+    {
+        if (!g.Oracle) return;
+        save.Camera.Record.Strings[SaveLoader.SeedKey] = oracleSeed.ToString(CultureInfo.InvariantCulture);
+        oracleSeedApplied = true;
+        oracleSelectedSpeed = null;
+        oraclePreparedControl = null;
+        oracleControlToken = null;
+        oracleFollowOffset = Vector3.Zero;
+        oracleFollowRestored = false;
+        StopOracleRun("cancelled");
+    }
+
+    void OracleFinishedLoad(string folder)
+    {
+        if (!g.Oracle) return;
+        session.Simulation.SetSpeed(0);
+        oracleLoadPending = false;
+        oracleLoadError = null;
+        saveInUse = folder;
+    }
+
+    void OracleLoadFailed(string error)
+    {
+        if (!g.Oracle || !oracleLoadPending) return;
+        oracleLoadPending = false;
+        oracleLoadError = error;
+        session?.Simulation.SetSpeed(0);
+    }
+
+    bool OracleReady => session is not null && player is not null && popData is not null && loadedSave is not null
+        && !Covered && !oracleLoadPending && oracleLoadError is null;
+    bool OracleRunning => oracleRun?.Status == "running";
+    bool OracleEdgeScroll(bool configured) => !g.Oracle ? configured : !oracleEdgeOwned && (oracleEdgeSetting ?? configured);
+
+    void ServiceOracle()
+    {
+        if (oracleServer is null) return;
+        ++oracleFrame;
+        // Drawing joins its worker. Settling the completed tick also advances the clock, so live state and time agree.
+        session.EndTickAhead();
+        if (OracleRunning) session.SettleAhead();
+        if (OracleRunning)
+        {
+            if (!OracleReady || oracleRun!.Epoch != worldEpoch) StopOracleRun("cancelled");
+            else if (OracleSeconds >= oracleRun.Target) StopOracleRun("completed");
+            else if (realTime.Elapsed.TotalSeconds >= oracleRun.Deadline) StopOracleRun("timed_out");
+        }
+        int drained = 0;
+        while (drained++ < 64 && oracleServer.TryDequeue(out var request))
+        {
+            if (request is null || request.IsCancelled) continue;
+            try
+            {
+                session.SettleAhead();
+                if (request.IsCancelled) continue;
+                request.Complete(ExecuteOracle(request.Command, request.Params));
+            }
+            catch (OracleHostError e) { request.Fail(e.Code, e.Message); }
+            catch (ArgumentException e) { request.Fail("invalid_request", e.Message); }
+            catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+            { request.Fail("io_error", e.Message); }
+            catch (Exception e) { request.Fail("state_unavailable", e.Message); }
+        }
+        double stamp = realTime.Elapsed.TotalMilliseconds;
+        oracleServer.PublishHeartbeat(new { frame = oracleFrame, timestamp_ms = stamp, service_frame = oracleFrame,
+            service_timestamp_ms = stamp, service_thread = Environment.CurrentManagedThreadId,
+            game_thread = Environment.CurrentManagedThreadId, loading = !OracleReady });
+    }
+
+    double OracleSeconds => session.Clock.TotalHours * 3600;
+    object OracleClock() => new { day = session.Clock.Day, hour = session.Clock.HourOfDay,
+        elapsed_seconds = OracleSeconds, speed = session.Simulation.IsPaused ? 0 : session.Simulation.Speed,
+        paused = session.Simulation.IsPaused };
+
+    void RequireOracleWorld(bool paused = false)
+    {
+        if (!OracleReady) throw new OracleHostError("world_not_ready", oracleLoadError ?? "a saved world is unavailable or loading");
+        if (paused && (!session.Simulation.IsPaused || OracleRunning))
+            throw new OracleHostError("invalid_request", "this command requires a paused checkpoint with no active advance");
+    }
+
+    object ExecuteOracle(string command, JsonElement p)
+    {
+        switch (command)
+        {
+            case "ping":
+                OracleKeys(p);
+                return new { target = "meitou", plugin_version = "0.10.0", game_version = "MeitouClient",
+                    schema_version = "0.2", supported_schema_versions = new[] { "0.1", "0.2" },
+                    instance_id = oracleInstance, process_id = Environment.ProcessId, oracle_available = true,
+                    world_ready = OracleReady, frame = oracleFrame, timestamp_ms = realTime.Elapsed.TotalMilliseconds,
+                    paused = session.Simulation.IsPaused, load_pause_pending = oracleLoadPending || Covered,
+                    current_save = saveInUse is null ? null : Path.GetFileName(Path.TrimEndingDirectorySeparator(saveInUse)),
+                    save_root = oracleSaveRoot, saved_origins_required = false, rekenshi_settings_available = false,
+                    seed = oracleSeed.ToString(CultureInfo.InvariantCulture), seed_source = oracleSeedSource,
+                    seed_applied_before_load = oracleSeedApplied, load_error = oracleLoadError,
+                    startup_boundary = "population_prepared_without_simulation_tick",
+                    set_game_speed_preserve_pause_available = true, camera_load_edge_lock_available = true,
+                    autosave_disabled_for_oracle = true };
+            case "get_clock":
+                OracleKeys(p); RequireOracleWorld(); return OracleClock();
+            case "dump_state": return DumpOracleState(p);
+            case "load_save": return LoadOracleSave(p);
+            case "pause":
+                OracleKeys(p, "paused"); RequireOracleWorld();
+                bool pause = OracleBool(p, "paused");
+                if (pause) StopOracleRun("cancelled");
+                session.Simulation.SetSpeed(pause ? 0 : oracleSelectedSpeed ?? session.Simulation.LastNonZeroSpeed);
+                return new { paused = session.Simulation.IsPaused };
+            case "set_game_speed": return SetOracleSpeed(p);
+            case "run_until": return StartOracleRun(p);
+            case "run_until_status": return QueryOracleRun(p, false);
+            case "cancel_run_until": return QueryOracleRun(p, true);
+            case "get_scene_state":
+                OracleKeys(p, "thread_details"); RequireOracleWorld();
+                if (p.TryGetProperty("thread_details", out _)) OracleBool(p, "thread_details");
+                return OracleScene();
+            case "set_camera_free": return SetOracleCamera(p);
+            case "prepare_scene_control": return PrepareOracleControl(p);
+            case "commit_scene_control": return CommitOracleControl(p);
+            case "restore_scene_control":
+                var control = ReadOracleControl(p); RequireOracleWorld(true); ApplyOracleControl(control);
+                oracleEdgeOwned = false; oracleEdgeSetting = control.Edge;
+                session.Simulation.SetSpeed(control.Paused ? 0 : control.Speed);
+                oraclePreparedControl = null; oracleControlToken = null;
+                return OracleControlResult(false, true);
+            case "issue_order": return IssueOracleOrder(p);
+            default: throw new OracleHostError("not_implemented", $"oracle command {command} is not implemented");
+        }
+    }
+
+    object DumpOracleState(JsonElement p)
+    {
+        OracleKeys(p, "filename", "schema_version"); RequireOracleWorld(true);
+        string filename = OracleText(p, "filename", 105);
+        OracleHostPolicy.ValidateFilename(filename);
+        string version = p.TryGetProperty("schema_version", out _) ? OracleText(p, "schema_version", 8) : "0.2";
+        if (version is not ("0.1" or "0.2")) throw new ArgumentException("unsupported state schema_version");
+        var state = oracleState!.Capture(session, popData!, version);
+        byte[] bytes = OracleCanonicalJson.Serialize(state);
+        if (bytes.Length > 64 * 1024 * 1024) throw new OracleHostError("state_unavailable", "state exceeds 64 MiB");
+        OracleHostPolicy.EnsureNoLinks(oracleOutput);
+        Directory.CreateDirectory(oracleOutput);
+        string path = Path.Combine(oracleOutput, filename);
+        OracleHostPolicy.EnsureNoLinks(path);
+        if (File.Exists(path)) throw new OracleHostError("already_exists", "snapshot already exists");
+        using (var file = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+        { file.Write(bytes); file.Flush(true); }
+        return new { path, schema_version = version, bytes = bytes.Length,
+            seed = oracleSeed.ToString(CultureInfo.InvariantCulture), seed_source = oracleSeedSource,
