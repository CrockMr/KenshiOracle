diff --git a/src/Meitou.Game/Oracle/OracleCanonicalJson.cs b/src/Meitou.Game/Oracle/OracleCanonicalJson.cs
new file mode 100644
index 00000000..2fa42efb
--- /dev/null
+++ b/src/Meitou.Game/Oracle/OracleCanonicalJson.cs
@@ -0,0 +1,148 @@
+using System.Globalization;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace Meitou.Game.Oracle;
+
+/// <summary>Oracle snapshot bytes: Python scalar ordering, binary64 quantisation, UTF-8 and one LF.</summary>
+internal static class OracleCanonicalJson
+{
+    static readonly UTF8Encoding Utf8 = new(false, true);
+    internal static readonly IComparer<string> ScalarOrder = Comparer<string>.Create(CompareScalars);
+
+    internal static byte[] Serialize(JsonNode node)
+    {
+        ArgumentNullException.ThrowIfNull(node);
+        var copy = node.DeepClone();
+        if (copy is JsonObject state && state["schema_version"]?.GetValue<string>() is "0.1" or "0.2")
+            OrderState(state);
+        var output = new StringBuilder();
+        Append(output, copy);
+        output.Append('\n');
+        return Utf8.GetBytes(output.ToString());
+    }
+
+    static int CompareScalars(string? first, string? second)
+    {
+        if (ReferenceEquals(first, second)) return 0;
+        if (first is null) return -1;
+        if (second is null) return 1;
+        var a = first.EnumerateRunes().GetEnumerator();
+        var b = second.EnumerateRunes().GetEnumerator();
+        while (true)
+        {
+            bool left = a.MoveNext(), right = b.MoveNext();
+            if (!left || !right) return left.CompareTo(right);
+            int compared = a.Current.Value.CompareTo(b.Current.Value);
+            if (compared != 0) return compared;
+        }
+    }
+
+    static void Sort(JsonObject parent, string key, Func<JsonNode, string> identity)
+    {
+        if (parent[key] is not JsonArray array) throw new JsonException($"Missing array: {key}");
+        var values = array.Select(row => row ?? throw new JsonException("Null collection entry")).ToArray();
+        var ids = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var value in values)
+            if (!ids.Add(identity(value))) throw new JsonException($"Duplicate identity in {key}");
+        Array.Sort(values, (a, b) => ScalarOrder.Compare(identity(a), identity(b)));
+        array.Clear();
+        foreach (var value in values) array.Add(value);
+    }
+
+    static string Id(JsonNode node) => node["id"]!.GetValue<string>();
+
+    static void OrderState(JsonObject state)
+    {
+        foreach (string key in new[] { "characters", "squads", "factions" }) Sort(state, key, Id);
+        // A separator cannot occur in contract IDs; this is the tuple's scalar lexical order.
+        Sort(state, "relations", row => row["source_id"]!.GetValue<string>() + '\0' + row["target_id"]!.GetValue<string>());
+        foreach (var node in state["characters"]!.AsArray())
+            if (node!["health"] is not null) Sort(node.AsObject(), "health", Id);
+        foreach (var node in state["squads"]!.AsArray())
+            Sort(node!.AsObject(), "members", row => row.GetValue<string>());
+    }
+
+    static void Append(StringBuilder output, JsonNode? node)
+    {
+        if (node is null) { output.Append("null"); return; }
+        if (node is JsonObject map)
+        {
+            output.Append('{');
+            bool first = true;
+            foreach (string key in map.Select(pair => pair.Key).Order(ScalarOrder))
+            {
+                if (!first) output.Append(',');
+                first = false;
+                Quote(output, key); output.Append(':'); Append(output, map[key]);
+            }
+            output.Append('}'); return;
+        }
+        if (node is JsonArray array)
+        {
+            output.Append('[');
+            for (int i = 0; i < array.Count; i++) { if (i != 0) output.Append(','); Append(output, array[i]); }
+            output.Append(']'); return;
+        }
+        switch (node.GetValueKind())
+        {
+            case JsonValueKind.String: Quote(output, node.GetValue<string>()); return;
+            case JsonValueKind.True: output.Append("true"); return;
+            case JsonValueKind.False: output.Append("false"); return;
+            case JsonValueKind.Null: output.Append("null"); return;
+            case JsonValueKind.Number:
+                double value = Binary64(node.AsValue());
+                if (!double.IsFinite(value) || Math.Abs(value) > 1e9) throw new JsonException("Oracle number outside finite canonical range");
+                ulong magnitude = (ulong)Math.Floor(Math.Abs(value) * 1_000_000.0 + 0.5);
+                if (value < 0 && magnitude != 0) output.Append('-');
+                output.Append((magnitude / 1_000_000).ToString(CultureInfo.InvariantCulture));
+                ulong fraction = magnitude % 1_000_000;
+                if (fraction != 0) output.Append('.').Append(fraction.ToString("D6", CultureInfo.InvariantCulture).TrimEnd('0'));
+                return;
+            default: throw new JsonException("Unsupported oracle JSON value");
+        }
+    }
+
+    static double Binary64(JsonValue value)
+    {
+        // A float must widen to binary64 before quantisation. Its shortest JSON spelling
+        // would round it a second time and can move a value across a half-micro boundary.
+        if (value.TryGetValue<JsonElement>(out var element)) return element.GetDouble();
+        if (value.TryGetValue<double>(out var d)) return d;
+        if (value.TryGetValue<float>(out var f)) return f;
+        if (value.TryGetValue<long>(out var l)) return l;
+        if (value.TryGetValue<ulong>(out var ul)) return ul;
+        if (value.TryGetValue<int>(out var i)) return i;
+        if (value.TryGetValue<uint>(out var ui)) return ui;
+        if (value.TryGetValue<short>(out var s)) return s;
+        if (value.TryGetValue<ushort>(out var us)) return us;
+        if (value.TryGetValue<byte>(out var b)) return b;
+        if (value.TryGetValue<sbyte>(out var sb)) return sb;
+        if (value.TryGetValue<decimal>(out var dec)) return (double)dec;
+        throw new JsonException("Unsupported oracle numeric representation");
+    }
+
+    static void Quote(StringBuilder output, string value)
+    {
+        // Validate before EnumerateRunes can replace an unpaired UTF-16 surrogate.
+        _ = Utf8.GetByteCount(value);
+        output.Append('"');
+        foreach (char c in value)
+            switch (c)
+            {
+                case '"': output.Append("\\\""); break;
+                case '\\': output.Append("\\\\"); break;
+                case '\b': output.Append("\\b"); break;
+                case '\f': output.Append("\\f"); break;
+                case '\n': output.Append("\\n"); break;
+                case '\r': output.Append("\\r"); break;
+                case '\t': output.Append("\\t"); break;
+                default:
+                    if (c < 32) output.Append("\\u").Append(((int)c).ToString("x4", CultureInfo.InvariantCulture));
+                    else output.Append(c);
+                    break;
+            }
+        output.Append('"');
+    }
+}
diff --git a/src/Meitou.Game/Oracle/OracleProtocol.cs b/src/Meitou.Game/Oracle/OracleProtocol.cs
new file mode 100644
index 00000000..877b7b96
--- /dev/null
+++ b/src/Meitou.Game/Oracle/OracleProtocol.cs
@@ -0,0 +1,162 @@
+using System.Text;
+using System.Text.Json;
+
+namespace Meitou.Game.Oracle;
+
+/// <summary>The bounded JSON-line envelope, independent of game state and snapshot encoding.</summary>
+internal static class OracleProtocol
+{
+    internal const int MaxLineBytes = 65536; // Includes the terminating LF.
+    internal const int QueueCapacity = 64;
+    static readonly UTF8Encoding Utf8 = new(false, true);
+    static readonly JsonElement Null = JsonSerializer.SerializeToElement<object?>(null);
+
+    internal static bool TryParse(ReadOnlyMemory<byte> line, out OracleRequest? request, out byte[]? error)
+    {
+        request = null;
+        var id = Null;
+        try
+        {
+            if (line.Length == 0 || line.Length >= MaxLineBytes)
+                throw new JsonException("Request line must contain 1..65535 UTF-8 bytes.");
+            // Validate every string, including parameters which the network does not otherwise read.
+            var text = Utf8.GetString(line.Span);
+            using var document = JsonDocument.Parse(text, new JsonDocumentOptions { MaxDepth = 64 });
+            var root = document.RootElement;
+            if (root.ValueKind != JsonValueKind.Object)
+                throw new JsonException("Request must be an object.");
+            if (root.TryGetProperty("id", out var candidate) && candidate.ValueKind == JsonValueKind.String
+                && Utf8.GetByteCount(candidate.GetString()!) is >= 1 and <= 64)
+                id = candidate.Clone();
+            else
+                throw new JsonException("id must be a string containing 1..64 UTF-8 bytes.");
+
+            ValidateUniqueProperties(root);
+            foreach (var property in root.EnumerateObject())
+                if (property.Name is not ("id" or "command" or "params"))
+                    throw new JsonException("Unknown request property.");
+            if (!root.TryGetProperty("command", out var command) || command.ValueKind != JsonValueKind.String
+                || string.IsNullOrEmpty(command.GetString()))
+                throw new JsonException("command must be a nonempty string.");
+            if (!root.TryGetProperty("params", out var parameters) || parameters.ValueKind != JsonValueKind.Object)
+                throw new JsonException("params must be an object.");
+            request = new OracleRequest(command.GetString()!, parameters.Clone(), id);
+            error = null;
+            return true;
+        }
+        catch (Exception ex) when (ex is JsonException or ArgumentException or InvalidOperationException)
+        {
+            error = Error(id, "invalid_request", ex.Message);
+            return false;
+        }
+    }
+
+    static void ValidateUniqueProperties(JsonElement value)
+    {
+        if (value.ValueKind == JsonValueKind.Object)
+        {
+            var names = new HashSet<string>(StringComparer.Ordinal);
+            foreach (var property in value.EnumerateObject())
+            {
+                if (!names.Add(property.Name)) throw new JsonException("Duplicate JSON property.");
+                ValidateUniqueProperties(property.Value);
+            }
+        }
+        else if (value.ValueKind == JsonValueKind.Array)
+            foreach (var item in value.EnumerateArray()) ValidateUniqueProperties(item);
+    }
+
+    internal static byte[] Result(JsonElement id, object? result)
+    {
+        try
+        {
+            using var buffer = new ResponseBuffer();
+            JsonSerializer.Serialize(buffer, new { id, result });
+            return WithNewline(buffer.ToArray());
+        }
+        catch (ResponseTooLargeException)
+        {
+            return Error(id, "response_too_large", "Response exceeds 64 KiB; full state must use a file.");
+        }
+        catch (Exception ex) when (ex is JsonException or NotSupportedException or ArgumentException or InvalidOperationException)
+        {
+            return Error(id, "internal_error", "Result could not be serialized as JSON.");
+        }
+    }
+
+    internal static byte[] Error(JsonElement id, string code, string message)
+    {
+        // Error text can originate in a host exception; it must not defeat the wire limit.
+        code = code.Length > 64 ? code[..64] : code;
+        message = message.Length > 512 ? message[..512] : message;
+        return WithNewline(JsonSerializer.SerializeToUtf8Bytes(new { id, error = new { code, message } }));
+    }
+
+    internal static byte[] Error(string code, string message) => Error(Null, code, message);
+
+    static byte[] WithNewline(byte[] json)
+    {
+        Array.Resize(ref json, json.Length + 1);
+        json[^1] = (byte)'\n';
+        return json;
+    }
+
+    sealed class ResponseTooLargeException : Exception { }
+
+    sealed class ResponseBuffer : Stream
+    {
+        readonly MemoryStream buffer = new();
+        public byte[] ToArray() => buffer.ToArray();
+        public override bool CanRead => false;
+        public override bool CanSeek => false;
+        public override bool CanWrite => true;
+        public override long Length => buffer.Length;
+        public override long Position { get => buffer.Position; set => throw new NotSupportedException(); }
+        public override void Flush() { }
+        public override int Read(byte[] bytes, int offset, int count) => throw new NotSupportedException();
+        public override long Seek(long offset, SeekOrigin origin) => throw new NotSupportedException();
+        public override void SetLength(long value) => throw new NotSupportedException();
+        public override void Write(byte[] buffer, int offset, int count) => Write(buffer.AsSpan(offset, count));
+        public override void Write(ReadOnlySpan<byte> bytes)
+        {
+            if (Length + bytes.Length >= MaxLineBytes) throw new ResponseTooLargeException();
+            buffer.Write(bytes);
+        }
+        public override void WriteByte(byte value)
+        {
+            if (Length + 1 >= MaxLineBytes) throw new ResponseTooLargeException();
+            buffer.WriteByte(value);
+        }
+        protected override void Dispose(bool disposing) { if (disposing) buffer.Dispose(); base.Dispose(disposing); }
+    }
+}
+
+/// <summary>A detached request. Only the host executes commands; completion freezes its reply.</summary>
+internal sealed class OracleRequest(string command, JsonElement parameters, JsonElement id)
+{
+    readonly TaskCompletionSource<byte[]> completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    int state; // 0 queued, 1 taken by host, 2 completed, 3 cancelled.
+
+    public string Command { get; } = command;
+    public JsonElement Params { get; } = parameters;
+    public JsonElement Id { get; } = id;
+    public bool IsCancelled => Volatile.Read(ref state) == 3;
+    internal Task<byte[]> Response => completion.Task;
+
+    internal bool TryTake() => Interlocked.CompareExchange(ref state, 1, 0) == 0;
+
+    public void Complete(object? result) => Finish(OracleProtocol.Result(Id, result), 2);
+    public void Fail(string code, string message) => Finish(OracleProtocol.Error(Id, code, message), 2);
+    internal void Cancel(string code, string message) => Finish(OracleProtocol.Error(Id, code, message), 3);
+
+    void Finish(byte[] response, int finalState)
+    {
+        int before;
+        do
+        {
+            before = Volatile.Read(ref state);
+            if (before is 2 or 3) return;
+        } while (Interlocked.CompareExchange(ref state, finalState, before) != before);
+        completion.TrySetResult(response);
+    }
+}
diff --git a/src/Meitou.Game/Oracle/OracleServer.cs b/src/Meitou.Game/Oracle/OracleServer.cs
new file mode 100644
index 00000000..c3f2d308
--- /dev/null
+++ b/src/Meitou.Game/Oracle/OracleServer.cs
@@ -0,0 +1,276 @@
+using System.Collections.Concurrent;
+using System.Diagnostics.CodeAnalysis;
+using System.Net;
+using System.Net.Sockets;
+using System.Text.Json;
+
+namespace Meitou.Game.Oracle;
+
+/// <summary>Loopback transport. The network reads published JSON and never touches the world.</summary>
+internal sealed class OracleServer : IDisposable
+{
+    const int MaxConnections = 128;
+    readonly TcpListener listener;
+    readonly CancellationTokenSource shutdown = new();
+    readonly ConcurrentDictionary<TcpClient, Task> clients = new();
+    readonly object clientsLock = new();
+    readonly Queue<OracleRequest> queue = new();
+    readonly object queueLock = new();
+    readonly TimeSpan commandTimeout;
+    readonly TimeSpan idleTimeout;
+    readonly Task accepting;
+    JsonElement heartbeat;
+    readonly object heartbeatLock = new();
+    int disposed;
+
+    public OracleServer(int port) : this(port, TimeSpan.FromSeconds(9), TimeSpan.FromSeconds(10)) { }
+
+    internal OracleServer(int port, TimeSpan commandTimeout, TimeSpan idleTimeout)
+    {
+        if (port is < 0 or > 65535) throw new ArgumentOutOfRangeException(nameof(port));
+        if (commandTimeout <= TimeSpan.Zero) throw new ArgumentOutOfRangeException(nameof(commandTimeout));
+        if (idleTimeout <= TimeSpan.Zero) throw new ArgumentOutOfRangeException(nameof(idleTimeout));
+        this.commandTimeout = commandTimeout;
+        this.idleTimeout = idleTimeout;
+        heartbeat = JsonSerializer.SerializeToElement(new
+        {
+            frame = 0, timestamp_ms = 0, service_frame = 0, service_timestamp_ms = 0,
+            service_thread = 0, game_thread = 0, loading = true,
+        });
+        listener = new TcpListener(IPAddress.Loopback, port);
+        listener.Server.ExclusiveAddressUse = true;
+        listener.Start(16);
+        LocalPort = ((IPEndPoint)listener.LocalEndpoint).Port;
+        accepting = AcceptAsync();
+    }
+
+    public int LocalPort { get; }
+
+    public bool TryDequeue([NotNullWhen(true)] out OracleRequest? request)
+    {
+        lock (queueLock)
+        {
+            while (queue.TryDequeue(out var candidate))
+                if (candidate.TryTake()) { request = candidate; return true; }
+        }
+        request = null;
+        return false;
+    }
+
+    public void PublishHeartbeat(object snapshot)
+    {
+        // Serialize on the publishing thread: later mutation cannot hide a stopped host.
+        var copy = JsonSerializer.SerializeToElement(snapshot);
+        if (copy.ValueKind != JsonValueKind.Object)
+            throw new ArgumentException("Heartbeat must be an object.", nameof(snapshot));
+        if (JsonSerializer.SerializeToUtf8Bytes(copy).Length > OracleProtocol.MaxLineBytes - 1024)
+            throw new ArgumentException("Heartbeat is too large.", nameof(snapshot));
+        lock (heartbeatLock) heartbeat = copy;
+    }
+
+    async Task AcceptAsync()
+    {
+        try
+        {
+            while (!shutdown.IsCancellationRequested)
+            {
+                var client = await listener.AcceptTcpClientAsync(shutdown.Token).ConfigureAwait(false);
+                lock (clientsLock)
+                {
+                    if (shutdown.IsCancellationRequested || clients.Count >= MaxConnections)
+                    {
+                        client.Dispose();
+                        continue;
+                    }
+                    client.NoDelay = true;
+                    var servicing = ServeAsync(client);
+                    clients[client] = servicing;
+                    _ = servicing.ContinueWith(_ => clients.TryRemove(client, out var ignored),
+                        CancellationToken.None, TaskContinuationOptions.ExecuteSynchronously, TaskScheduler.Default);
+                }
+            }
+        }
+        catch (Exception ex) when (ex is OperationCanceledException or SocketException or ObjectDisposedException)
+        {
+            // Closing the listener releases its only outstanding accept.
+        }
+    }
+
+    async Task ServeAsync(TcpClient client)
+    {
+        using (client)
+        {
+            try
+            {
+                using var stream = client.GetStream();
+                // TcpClient.Dispose clears Client; retain the socket object so a concurrent
+                // shutdown produces a handled ObjectDisposedException instead of a null race.
+                var socket = client.Client;
+                if (socket is null) return;
+                var lines = new LineReader(stream);
+                while (!shutdown.IsCancellationRequested)
+                {
+                    byte[]? line;
+                    using (var read = CancellationTokenSource.CreateLinkedTokenSource(shutdown.Token))
+                    {
+                        read.CancelAfter(idleTimeout);
+                        line = await lines.ReadAsync(read.Token).ConfigureAwait(false);
+                    }
+                    if (line is null) return;
+                    byte[] reply;
+                    if (line.Length >= OracleProtocol.MaxLineBytes)
+                    {
+                        reply = OracleProtocol.Error("invalid_request", "Request line exceeds 64 KiB.");
+                        await WriteAsync(stream, reply).ConfigureAwait(false);
+                        await RejectRemainderAsync(socket, stream).ConfigureAwait(false);
+                        return; // Do not interpret the remainder of an overlong line as another command.
+                    }
+                    if (!OracleProtocol.TryParse(line, out var request, out var error)) reply = error!;
+                    else if (request!.Command == "heartbeat")
+                    {
+                        if (request.Params.EnumerateObject().Any())
+                            reply = OracleProtocol.Error(request.Id, "invalid_request", "heartbeat takes no parameters.");
+                        else
+                        {
+                            JsonElement copy;
+                            lock (heartbeatLock) copy = heartbeat;
+                            reply = OracleProtocol.Result(request.Id, copy);
+                        }
+                    }
+                    else reply = await DispatchAsync(socket, request).ConfigureAwait(false);
+                    await WriteAsync(stream, reply).ConfigureAwait(false);
+                }
+            }
+            catch (Exception ex) when (ex is IOException or SocketException or OperationCanceledException or ObjectDisposedException)
+            {
+                // Disconnected, idle or disposed clients have no retained socket or pending mutation.
+            }
+        }
+    }
+
+    async Task<byte[]> DispatchAsync(Socket socket, OracleRequest request)
+    {
+        lock (queueLock)
+        {
+            // Remove cancelled entries before deciding whether the bounded queue is full.
+            int count = queue.Count;
+            for (int i = 0; i < count; i++)
+            {
+                var candidate = queue.Dequeue();
+                if (!candidate.IsCancelled) queue.Enqueue(candidate);
+            }
+            if (queue.Count >= OracleProtocol.QueueCapacity)
+                return OracleProtocol.Error(request.Id, "busy", "Host command queue is full.");
+            if (shutdown.IsCancellationRequested)
+                return OracleProtocol.Error(request.Id, "cancelled", "Oracle server is stopping.");
+            queue.Enqueue(request);
+        }
+
+        using var deadline = CancellationTokenSource.CreateLinkedTokenSource(shutdown.Token);
+        deadline.CancelAfter(commandTimeout);
+        try
+        {
+            while (!request.Response.IsCompleted)
+            {
+                if (socket.Poll(0, SelectMode.SelectRead) && socket.Available == 0)
+                {
+                    request.Cancel("cancelled", "Client disconnected; execution may already have started.");
+                    break;
+                }
+                await Task.WhenAny(request.Response, Task.Delay(100, deadline.Token)).ConfigureAwait(false);
+                deadline.Token.ThrowIfCancellationRequested();
+            }
+            return await request.Response.ConfigureAwait(false);
+        }
+        catch (OperationCanceledException)
+        {
+            request.Cancel(shutdown.IsCancellationRequested ? "cancelled" : "timeout",
+                "Host response timed out or server stopped; execution may already have started.");
+            return await request.Response.ConfigureAwait(false);
+        }
+        finally
+        {
+            request.Cancel("cancelled", "Client request ended; execution may already have started.");
+        }
+    }
+
+    async Task WriteAsync(NetworkStream stream, byte[] reply)
+    {
+        using var write = CancellationTokenSource.CreateLinkedTokenSource(shutdown.Token);
+        write.CancelAfter(idleTimeout);
+        await stream.WriteAsync(reply, write.Token).ConfigureAwait(false);
+    }
+
+    async Task RejectRemainderAsync(Socket socket, NetworkStream stream)
+    {
+        // On Windows, closing with unread input resets TCP and can discard the error reply.
+        // Send a FIN, then discard a bounded tail without ever treating it as another request.
+        socket.Shutdown(SocketShutdown.Send);
+        using var drain = CancellationTokenSource.CreateLinkedTokenSource(shutdown.Token);
+        drain.CancelAfter(TimeSpan.FromMilliseconds(500));
+        var discarded = new byte[4096];
+        int remaining = OracleProtocol.MaxLineBytes;
+        try
+        {
+            while (remaining > 0)
+            {
+                int read = await stream.ReadAsync(discarded.AsMemory(0, Math.Min(discarded.Length, remaining)),
+                    drain.Token).ConfigureAwait(false);
+                if (read == 0) break;
+                remaining -= read;
+            }
+        }
+        catch (OperationCanceledException) { }
+    }
+
+    public void Dispose()
+    {
+        if (Interlocked.Exchange(ref disposed, 1) != 0) return;
+        shutdown.Cancel();
+        listener.Stop();
+        Task[] remaining;
+        lock (clientsLock)
+        {
+            foreach (var client in clients.Keys) client.Dispose();
+            remaining = clients.Values.Prepend(accepting).ToArray();
+        }
+        lock (queueLock)
+            while (queue.TryDequeue(out var request)) request.Cancel("cancelled", "Oracle server stopped.");
+        // Every I/O is cancellable and sockets are closed above; avoid leaving background work behind.
+        try { Task.WhenAll(remaining).GetAwaiter().GetResult(); }
+        catch (Exception ex) when (ex is IOException or SocketException or OperationCanceledException or ObjectDisposedException) { }
+        shutdown.Dispose();
+    }
+
+    sealed class LineReader(NetworkStream stream)
+    {
+        readonly byte[] buffer = new byte[4096];
+        readonly byte[] line = new byte[OracleProtocol.MaxLineBytes];
+        int position, available, length;
+
+        public async Task<byte[]?> ReadAsync(CancellationToken cancellationToken)
+        {
+            while (true)
+            {
+                if (position == available)
+                {
+                    available = await stream.ReadAsync(buffer, cancellationToken).ConfigureAwait(false);
+                    position = 0;
+                    if (available == 0) return null; // Unterminated input cannot execute.
+                }
+                var newline = Array.IndexOf(buffer, (byte)'\n', position, available - position);
+                int end = newline >= 0 ? newline : available;
+                int count = end - position;
+                if (length + count >= OracleProtocol.MaxLineBytes)
+                    return new byte[OracleProtocol.MaxLineBytes]; // Bounded overlong-line sentinel.
+                Array.Copy(buffer, position, line, length, count);
+                length += count;
+                position = newline >= 0 ? end + 1 : end;
+                if (newline < 0) continue;
+                var result = line.AsSpan(0, length).ToArray();
+                length = 0;
+                return result;
+            }
+        }
+    }
+}
diff --git a/src/Meitou.Game/Oracle/OracleState.cs b/src/Meitou.Game/Oracle/OracleState.cs
new file mode 100644
index 00000000..a4f9dd3f
--- /dev/null
+++ b/src/Meitou.Game/Oracle/OracleState.cs
@@ -0,0 +1,183 @@
+using System.Globalization;
+using System.Numerics;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Meitou.Data.Gameplay.Bodies;
+using Meitou.Data.Save;
+using Meitou.Engine;
+using Meitou.Simulation;
+using Meitou.Simulation.Combat;
+
+namespace Meitou.Game.Oracle;
+
+/// <summary>Reads a settled world without advancing it. Caches belong to one World, never to a save name.</summary>
+internal sealed class OracleState
+{
+    World? world;
+    readonly Dictionary<CharacterId, string> characterIds = [];
+    readonly Dictionary<int, string> squadIds = [];
+    readonly HashSet<CharacterId> savedCharacters = [];
+    readonly HashSet<int> savedSquads = [];
+    readonly Dictionary<string, CharacterId> currentCharacters = new(StringComparer.Ordinal);
+    readonly Dictionary<string, int> currentSquads = new(StringComparer.Ordinal);
+
+    internal string? CharacterIdentity(CharacterId id) =>
+        characterIds.TryGetValue(id, out string? identity) && currentCharacters.ContainsKey(identity) ? identity : null;
+
+    internal bool TryResolveCharacter(string identity, out CharacterId id) => currentCharacters.TryGetValue(identity, out id);
+    internal bool TryResolveSquad(string identity, out int id) => currentSquads.TryGetValue(identity, out id);
+
+    internal static string SavedHandId(Hand hand) => string.Create(CultureInfo.InvariantCulture,
+        $"hand:{unchecked((uint)hand.Type)}:{unchecked((uint)hand.C)}:{unchecked((uint)hand.CS)}:{unchecked((uint)hand.I)}:{unchecked((uint)hand.S)}");
+
+    internal JsonObject Capture(WorldSession session, PopulationData data, string schemaVersion = "0.2")
+    {
+        if (schemaVersion is not ("0.1" or "0.2")) throw new ArgumentException("Unsupported oracle state schema", nameof(schemaVersion));
+        if (!ReferenceEquals(world, session.World))
+        {
+            world = session.World;
+            characterIds.Clear(); squadIds.Clear(); savedCharacters.Clear(); savedSquads.Clear();
+        }
+        currentCharacters.Clear(); currentSquads.Clear();
+        var table = world.Characters;
+        var hot = table.Previous;
+        var live = new List<CharacterId>();
+        for (int slot = 0; slot < hot.Length; slot++)
+        {
+            if (!hot[slot].Alive) continue;
+            var id = table.IdOf(slot);
+            if (table.Cold(slot)?.Save?.Source.Handle is { IsNull: false, Type: 1 } hand)
+            {
+                characterIds[id] = SavedHandId(hand);
+                savedCharacters.Add(id);
+            }
+            if (!characterIds.ContainsKey(id)) characterIds[id] = LocalIdentity("character", id.ToString());
+            if (!currentCharacters.TryAdd(characterIds[id], id)) throw new JsonException("Ambiguous saved character identity");
+            live.Add(id);
+        }
+        var squads = world.Squads.All.ToArray();
+        foreach (var squad in squads)
+        {
+            // Each source is a full saved PLATOON handle, not its name or shortened (C,I) resolver.
+            var sources = squad.Members.Where(table.IsAlive)
+                .Select(id => table.Cold(id.Slot)?.Save?.Source.Platoon.Handle)
+                .Where(h => h is { IsNull: false, Type: 34 }).Select(h => h!.Value).Distinct().ToList();
+            if (world.Platoons.Find(squad.PlatoonId)?.Saved?.Source.Handle is { IsNull: false, Type: 34 } platoonHand)
+                sources.Add(platoonHand);
+            if (sources.Distinct().ToArray() is [var source])
+            {
+                // Member sources establish the squad only when the saved player name also agrees;
+                // an NPC's Saved platoon is an explicit loader link.
+                bool direct = world.Platoons.Find(squad.PlatoonId)?.Saved?.Source.Handle == source;
+                bool membersAgree = squad.SaveName is not null && squad.Members.Where(table.IsAlive).All(id =>
+                    table.Cold(id.Slot)?.Save is { } saved && saved.Source.Platoon.Handle == source
+                    && saved.Source.Platoon.Name == squad.SaveName);
+                if (direct || membersAgree)
+                {
+                    squadIds[squad.Id] = SavedHandId(source);
+                    savedSquads.Add(squad.Id);
+                }
+            }
+            if (!squadIds.ContainsKey(squad.Id)) squadIds[squad.Id] = LocalIdentity("squad", squad.Id.ToString(CultureInfo.InvariantCulture));
+            if (!currentSquads.TryAdd(squadIds[squad.Id], squad.Id)) throw new JsonException("Ambiguous saved squad identity");
+        }
+        string? Faction(int index) => (uint)index < (uint)data.Factions.Count ? KnownId(data.Factions[index].Id) : null;
+        var characters = new JsonArray();
+        // CombatMode is published by the exact broad (true,true) predicate. No system or stale snapshot means unknown.
+        var combat = world.Systems.OfType<CombatSystem>().Any() && world.Snapshot.Tick == world.Tick
+            ? world.Snapshot.Characters.ToDictionary(c => c.Id, c => c.CombatMode) : [];
+        foreach (var id in live.OrderBy(id => characterIds[id], OracleCanonicalJson.ScalarOrder))
+        {
+            var cold = table.Cold(id.Slot);
+            var medical = cold?.Medical;
+            JsonArray? health = null;
+            if (medical is not null)
+            {
+                health = new JsonArray();
+                var partIds = new HashSet<string>(StringComparer.Ordinal);
+                foreach (var part in medical.Parts.OrderBy(p => p.Template.StringId + Side(p.Template.Side), OracleCanonicalJson.ScalarOrder))
+                {
+                    string partId = part.Template.StringId + Side(part.Template.Side);
+                    if (KnownId(part.Template.StringId) is null || !partIds.Add(partId)) { health = null; break; }
+                    health.Add(new JsonObject { ["id"] = partId, ["current"] = Number(part.Flesh), ["stun"] = Number(part.Stun),
+                        // The original exposes stored _maxHealth. Equivalence with calculated MaxHp is not established.
+                        ["maximum"] = null });
+                }
+            }
+            var row = new JsonObject
+            {
+                ["id"] = characterIds[id], ["name"] = cold?.Name ?? "", ["race_id"] = KnownId(cold?.Race?.StringId),
+                ["faction_id"] = Faction(cold?.Faction ?? -1),
+                ["squad_id"] = cold is not null && squadIds.TryGetValue(cold.SquadId, out var sid) && currentSquads.ContainsKey(sid) ? sid : null,
+                ["position"] = Position(hot[id.Slot].Position),
+                ["state"] = medical is null ? null : medical.Dead ? "dead" : medical.Unconscious ? "unconscious" : "alive",
+                ["health"] = health,
+                // A Meitou movement/AI task is not by itself proof of the original TaskType.
+                ["order"] = null,
+            };
+            if (schemaVersion == "0.2")
+            {
+                row["identity_origin"] = savedCharacters.Contains(id) ? "saved" : null;
+                row["current_town_id"] = null; row["town_assignment"] = null;
+                row["in_combat"] = combat.TryGetValue(id, out bool mode) ? JsonValue.Create(mode) : null;
+            }
+            characters.Add(row);
+        }
+        var squadRows = new JsonArray();
+        foreach (var squad in squads.OrderBy(s => squadIds[s.Id], OracleCanonicalJson.ScalarOrder))
+        {
+            var members = new JsonArray();
+            foreach (string member in live.Where(id => table.Cold(id.Slot)?.SquadId == squad.Id)
+                         .Select(id => characterIds[id]).Order(OracleCanonicalJson.ScalarOrder)) members.Add(member);
+            var row = new JsonObject { ["id"] = squadIds[squad.Id], ["faction_id"] = Faction(squad.Faction), ["members"] = members,
+                ["leader_id"] = CharacterIdentity(squad.Leader) };
+            if (schemaVersion == "0.2")
+            {
+                row["identity_origin"] = savedSquads.Contains(squad.Id) ? "saved" : null;
+                row["template_id"] = KnownId(squad.TemplateId); row["origin_town_id"] = null;
+            }
+            squadRows.Add(row);
+        }
+        var factions = new JsonArray();
+        var relations = new JsonArray();
+        var factionIds = new HashSet<string>(StringComparer.Ordinal);
+        var orderedFactions = data.Factions.Select((f, index) => (Faction: f, Index: index))
+            .OrderBy(row => row.Faction.Id, OracleCanonicalJson.ScalarOrder).ToArray();
+        foreach (var (faction, index) in orderedFactions)
+        {
+            if (KnownId(faction.Id) is null || !factionIds.Add(faction.Id)) throw new JsonException("Invalid or duplicate faction identity");
+            factions.Add(new JsonObject { ["id"] = faction.Id, ["name"] = faction.Name });
+            foreach (var (target, targetIndex) in orderedFactions)
+            {
+                if (index == targetIndex) continue;
+                // Match by stable IDs, not assumptions about the relation table's ordering.
+                int a = data.Relations.IndexOf(faction.Id), b = data.Relations.IndexOf(target.Id);
+                relations.Add(new JsonObject { ["source_id"] = faction.Id, ["target_id"] = target.Id,
+                    ["value"] = a >= 0 && b >= 0 ? Number(data.Relations.Get(a, b)) : null });
+            }
+        }
+        return new JsonObject
+        {
+            ["schema_version"] = schemaVersion,
+            ["clock"] = new JsonObject { ["day"] = session.Clock.Day, ["hour"] = session.Clock.HourOfDay,
+                ["elapsed_seconds"] = session.Clock.TotalHours * 3600,
+                ["speed"] = session.Simulation.IsPaused ? 0 : session.TimeScale, ["paused"] = session.Simulation.IsPaused },
+            ["characters"] = characters, ["squads"] = squadRows, ["factions"] = factions, ["relations"] = relations,
+        };
+    }
+
+    string LocalIdentity(string kind, string engineIdentity)
+    {
+        // An opaque world-local engine identity; it establishes neither saved origin nor cross-engine equivalence.
+        string material = string.Create(CultureInfo.InvariantCulture, $"meitou-oracle:{world!.Seed}:{kind}:{engineIdentity}");
+        return "local:" + kind + ":" + Convert.ToHexStringLower(SHA256.HashData(Encoding.UTF8.GetBytes(material)));
+    }
+
+    static string Side(BodySide side) => side switch { BodySide.Left => ":left", BodySide.Right => ":right", _ => ":neither" };
+    static string? KnownId(string? value) => !string.IsNullOrEmpty(value) && value.Length <= 512 && !value.Any(c => c < 32 || c == 127) ? value : null;
+    static JsonNode? Number(double value) => double.IsFinite(value) && Math.Abs(value) <= 1e9 ? JsonValue.Create(value) : null;
+    static JsonArray? Position(Vector3 value) => float.IsFinite(value.X) && float.IsFinite(value.Y) && float.IsFinite(value.Z)
+        && Math.Abs(value.X) <= 1e9 && Math.Abs(value.Y) <= 1e9 && Math.Abs(value.Z) <= 1e9 ? new JsonArray(value.X, value.Y, value.Z) : null;
+}
