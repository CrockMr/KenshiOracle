new file mode 100644
index 00000000..1060b5ff
--- /dev/null
+++ b/tests/Meitou.Tests/Oracle/OracleCanonicalJsonTests.cs
@@ -0,0 +1,73 @@
+using System.Runtime.CompilerServices;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json.Nodes;
+using Meitou.Game.Oracle;
+
+namespace Meitou.Tests.Oracle;
+
+public class OracleCanonicalJsonTests
+{
+    // SHA-256 of the fixture with CRLF normalised to LF, so checkouts with either line ending agree.
+    const string VectorHash = "d41b18288b8510e379ff7bcc62212d018ec75fe80edfa045f8c2df2b17a03cad";
+
+    static string VectorPath([CallerFilePath] string source = "") => Environment.GetEnvironmentVariable("KENSHI_ORACLE_VECTORS")
+        ?? Path.Combine(Path.GetDirectoryName(source)!, "Fixtures", "canonical-vectors.json");
+
+    static byte[] LfNormalised(byte[] bytes) =>
+        Encoding.UTF8.GetBytes(Encoding.UTF8.GetString(bytes).Replace("\r\n", "\n"));
+
+    public static IEnumerable<object[]> Cases()
+    {
+        foreach (var row in JsonNode.Parse(File.ReadAllBytes(VectorPath()))!["cases"]!.AsArray())
+            yield return [row!["name"]!.GetValue<string>(), row["input"]!.ToJsonString(), row["expected_base64"]!.GetValue<string>()];
+    }
+
+    [Theory, MemberData(nameof(Cases))]
+    public void Matches_shared_python_and_native_vectors(string name, string json, string expected)
+    {
+        var state = JsonNode.Parse(json)!;
+        string original = state.ToJsonString();
+        Assert.Equal(Convert.FromBase64String(expected), OracleCanonicalJson.Serialize(state));
+        Assert.Equal(original, state.ToJsonString());
+        Assert.NotEmpty(name);
+    }
+
+    [Fact]
+    public void Shared_fixture_is_the_documented_identical_copy()
+    {
+        byte[] bytes = File.ReadAllBytes(VectorPath());
+        Assert.Equal(VectorHash, Convert.ToHexStringLower(SHA256.HashData(LfNormalised(bytes))));
+        var document = JsonNode.Parse(bytes)!;
+        Assert.Equal(59, document["historical_case_count"]!.GetValue<int>());
+        using var historical = new MemoryStream();
+        foreach (var row in document["cases"]!.AsArray().Take(59))
+            historical.Write(Convert.FromBase64String(row!["expected_base64"]!.GetValue<string>()));
+        Assert.Equal("413a593b4b2378ecffdba277942ed6ef0797302667a1f02e39260ff5c7b8fab7",
+            Convert.ToHexStringLower(SHA256.HashData(historical.ToArray())));
+    }
+
+    [Fact]
+    public void Rejects_invalid_unicode_and_out_of_range_numbers()
+    {
+        Assert.Throws<EncoderFallbackException>(() => OracleCanonicalJson.Serialize(JsonValue.Create("\ud800")!));
+        Assert.Throws<System.Text.Json.JsonException>(() => OracleCanonicalJson.Serialize(JsonValue.Create(1_000_000_001d)!));
+        Assert.ThrowsAny<Exception>(() => OracleCanonicalJson.Serialize(JsonValue.Create(double.NaN)!));
+    }
+
+    [Fact]
+    public void Duplicate_state_identity_is_rejected()
+    {
+        var document = JsonNode.Parse(File.ReadAllBytes(VectorPath()))!;
+        var state = document["cases"]![0]!["input"]!.DeepClone();
+        state["characters"]!.AsArray().Add(state["characters"]![0]!.DeepClone());
+        Assert.Throws<System.Text.Json.JsonException>(() => OracleCanonicalJson.Serialize(state));
+    }
+
+    [Fact]
+    public void Float_is_promoted_to_binary64_before_quantisation()
+    {
+        Assert.Equal("0\n", Encoding.UTF8.GetString(OracleCanonicalJson.Serialize(JsonValue.Create(0.0000005f)!)));
+        Assert.Equal("0.000001\n", Encoding.UTF8.GetString(OracleCanonicalJson.Serialize(JsonValue.Create(0.0000005d)!)));
+    }
+}
diff --git a/tests/Meitou.Tests/Oracle/OracleHostPolicyTests.cs b/tests/Meitou.Tests/Oracle/OracleHostPolicyTests.cs
new file mode 100644
index 00000000..75ee2a30
--- /dev/null
+++ b/tests/Meitou.Tests/Oracle/OracleHostPolicyTests.cs
@@ -0,0 +1,101 @@
+using System.Text.Json;
+using System.Numerics;
+using Meitou.Game;
+using Meitou.Engine;
+using Meitou.Simulation;
+using SimWorld = Meitou.Simulation.World;
+
+namespace Meitou.Tests.Oracle;
+
+public class OracleHostPolicyTests
+{
+    sealed class OffscreenConflict : ITickSystem
+    {
+        public CharacterId Victim;
+        public int Resolutions;
+        public void SlowWorld(SimWorld world)
+        {
+            ++Resolutions;
+            world.Characters.Remove(Victim);
+        }
+    }
+
+    [Fact]
+    public void Oracle_load_keeps_saved_actors_and_time_intact_until_the_first_requested_advance()
+    {
+        var conflict = new OffscreenConflict();
+        using var session = new WorldSession(Vector3.Zero, (-100, -100, 100, 100), (_, _) => 0,
+            systems: [conflict], simulation: new WorldSettings { Seed = 1729 });
+        conflict.Victim = session.World.Characters.Spawn(new CharacterHot { Position = new Vector3(1, 2, 3) }, new CharacterCold(), 0);
+        double time = session.Clock.TotalHours;
+        session.Clock.SetTime(16, 20);
+        time = session.Clock.TotalHours;
+        OracleHostPolicy.PrepareLoadedWorld(session, Vector3.Zero, oracle: true);
+        Assert.True(session.World.Characters.IsAlive(conflict.Victim));
+        Assert.Equal(0, conflict.Resolutions);
+        Assert.Equal(0, session.World.Tick);
+        Assert.Equal(time, session.Clock.TotalHours);
+        Assert.Equal(time, session.World.GameHours);
+        Assert.Equal(session.Clock.IsDaytime, session.World.Daytime);
+        Assert.Equal(1729UL, session.World.Seed);
+        // No combat system was disabled: its normal first advance still resolves the conflict.
+        session.AdvanceSimulation(session.Simulation.TickSeconds);
+        Assert.Equal(1, conflict.Resolutions);
+        Assert.False(session.World.Characters.IsAlive(conflict.Victim));
+        Assert.Equal(1, session.World.Tick);
+        Assert.True(session.Clock.TotalHours > time);
+    }
+
+    [Fact]
+    public void Ordinary_load_keeps_the_existing_initial_tick_behavior()
+    {
+        var conflict = new OffscreenConflict();
+        using var session = new WorldSession(Vector3.Zero, (-100, -100, 100, 100), (_, _) => 0, systems: [conflict]);
+        conflict.Victim = session.World.Characters.Spawn(new CharacterHot(), new CharacterCold(), 0);
+        OracleHostPolicy.PrepareLoadedWorld(session, Vector3.Zero, oracle: false);
+        Assert.Equal(1, session.World.Tick);
+        Assert.Equal(1, conflict.Resolutions);
+        Assert.False(session.World.Characters.IsAlive(conflict.Victim));
+    }
+
+    [Fact]
+    public void Ordinary_launch_has_no_oracle_and_oracle_options_are_not_world_options()
+    {
+        var (ordinary, rest) = GameOptions.Split(["--seed", "9", "--town", "The Hub"]);
+        Assert.False(ordinary.Oracle);
+        Assert.Equal(["--town", "The Hub"], rest);
+        var (enabled, remaining) = GameOptions.Split(["--oracle", "--oracle-port", "47802", "--oracle-output", "captures", "--load", "saves/test"]);
+        Assert.True(enabled.Oracle);
+        Assert.Equal(47802, enabled.OraclePort);
+        Assert.Equal("captures", enabled.OracleOutput);
+        Assert.Empty(remaining);
+        Assert.Throws<ArgumentException>(() => GameOptions.Split(["--oracle-port", "47801"]));
+        Assert.Throws<ArgumentException>(() => GameOptions.Split(["--oracle", "--oracle-port", "0"]));
+        Assert.Throws<ArgumentException>(() => GameOptions.Split(["--oracle", "--no-population"]));
+    }
+
+    [Theory]
+    [InlineData("../escape")]
+    [InlineData("..")]
+    [InlineData("C:\\save")]
+    [InlineData("inside/other")]
+    [InlineData("tail.")]
+    public void Loading_only_accepts_one_folder_name(string name) => Assert.Throws<ArgumentException>(() => OracleHostPolicy.ValidateSaveName(name));
+
+    [Theory]
+    [InlineData("../escape.json")]
+    [InlineData("CON.json")]
+    [InlineData("COM1.json")]
+    [InlineData("name.JSON")]
+    [InlineData("é.json")]
+    public void Snapshot_names_cannot_escape_or_use_reserved_devices(string name) => Assert.Throws<ArgumentException>(() => OracleHostPolicy.ValidateFilename(name));
+
+    [Fact]
+    public void A_decimal_string_preserves_the_entire_uint64_seed_and_fractional_or_negative_seeds_fail()
+    {
+        using var values = JsonDocument.Parse("[\"18446744073709551615\",18446744073709551615,1.5,-1,\"+2\"]");
+        Assert.Equal(ulong.MaxValue, OracleHostPolicy.ReadSeed(values.RootElement[0]));
+        Assert.Equal(ulong.MaxValue, OracleHostPolicy.ReadSeed(values.RootElement[1]));
+        for (int i = 2; i < 5; i++) Assert.Throws<ArgumentException>(() => OracleHostPolicy.ReadSeed(values.RootElement[i]));
+    }
+}
diff --git a/tests/Meitou.Tests/Oracle/OracleProtocolTests.cs b/tests/Meitou.Tests/Oracle/OracleProtocolTests.cs
new file mode 100644
index 00000000..9d963e67
--- /dev/null
+++ b/tests/Meitou.Tests/Oracle/OracleProtocolTests.cs
@@ -0,0 +1,75 @@
+using System.Text;
+using System.Text.Json;
+using Meitou.Game.Oracle;
+
+namespace Meitou.Tests.Oracle;
+
+public class OracleProtocolTests
+{
+    [Fact]
+    public void Parsed_request_owns_its_id_and_nested_parameters()
+    {
+        Assert.True(Parse("""{"id":"req-1","command":"issue_order","params":{"actors":["7:9"],"position":{"x":2}}}""", out var request, out var error));
+        Assert.Null(error);
+        Assert.Equal("req-1", request!.Id.GetString());
+        Assert.Equal("issue_order", request.Command);
+        Assert.Equal("7:9", request.Params.GetProperty("actors")[0].GetString());
+        Assert.Equal(2, request.Params.GetProperty("position").GetProperty("x").GetInt32());
+        request.Complete(new { accepted = true });
+        // The JSON document used by the parser was disposed before any of these reads.
+        Assert.Equal("req-1", request.Id.GetString());
+    }
+
+    [Theory]
+    [InlineData("[]")]
+    [InlineData("{\"id\":7,\"command\":\"ping\",\"params\":{}}")]
+    [InlineData("{\"id\":\"\",\"command\":\"ping\",\"params\":{}}")]
+    [InlineData("{\"id\":\"a\",\"command\":\"ping\"}")]
+    [InlineData("{\"id\":\"a\",\"command\":\"ping\",\"params\":[]}")]
+    [InlineData("{\"id\":\"a\",\"command\":\"\",\"params\":{}}")]
+    [InlineData("{\"id\":\"a\",\"command\":\"ping\",\"params\":{},\"extra\":true}")]
+    [InlineData("{\"id\":\"a\",\"command\":\"ping\",\"command\":\"pause\",\"params\":{}}")]
+    [InlineData("{\"id\":\"a\",\"command\":\"pause\",\"params\":{\"paused\":true,\"paused\":false}}")]
+    [InlineData("{\"id\":\"a\",\"command\":\"ping\",\"params\":{}} trailing")]
+    public void Ambiguous_or_invalid_envelopes_are_rejected(string json)
+    {
+        Assert.False(Parse(json, out var request, out var error));
+        Assert.Null(request);
+        using var reply = JsonDocument.Parse(error!);
+        Assert.Equal("invalid_request", reply.RootElement.GetProperty("error").GetProperty("code").GetString());
+    }
+
+    [Fact]
+    public void Id_limit_counts_utf8_bytes_and_invalid_utf8_in_parameters_is_rejected()
+    {
+        string Make(string id) => JsonSerializer.Serialize(new { id, command = "ping", @params = new { } });
+        Assert.True(Parse(Make(new string('é', 32)), out _, out _));
+        Assert.False(Parse(Make(new string('é', 33)), out _, out _));
+        var prefix = Encoding.UTF8.GetBytes("{\"id\":\"a\",\"command\":\"ping\",\"params\":{\"text\":\"");
+        var invalid = prefix.Concat(new byte[] { 0xc0, 0xaf }).Concat(Encoding.UTF8.GetBytes("\"}}")).ToArray();
+        Assert.False(OracleProtocol.TryParse(invalid, out _, out _));
+        Assert.False(OracleProtocol.TryParse(new byte[OracleProtocol.MaxLineBytes], out _, out _));
+    }
+
+    [Fact]
+    public async Task Reply_envelope_is_bounded_and_completion_is_once_only()
+    {
+        Assert.True(Parse("""{"id":"bound","command":"dump_state","params":{}}""", out var request, out _));
+        request!.Complete(new { accidental_inline_state = new string('x', OracleProtocol.MaxLineBytes) });
+        request.Complete(new { replacement = true });
+        var wire = await request.Response;
+        Assert.True(wire.Length <= OracleProtocol.MaxLineBytes);
+        Assert.Equal((byte)'\n', wire[^1]);
+        using var reply = JsonDocument.Parse(wire);
+        Assert.Equal("bound", reply.RootElement.GetProperty("id").GetString());
+        Assert.Equal("response_too_large", reply.RootElement.GetProperty("error").GetProperty("code").GetString());
+
+        using var invalid = JsonDocument.Parse(OracleProtocol.Result(request.Id, new { value = double.NaN }));
+        Assert.Equal("internal_error", invalid.RootElement.GetProperty("error").GetProperty("code").GetString());
+        using var longError = JsonDocument.Parse(OracleProtocol.Error(request.Id, new string('x', 100000), new string('é', 100000)));
+        Assert.True(Encoding.UTF8.GetByteCount(longError.RootElement.GetRawText()) < OracleProtocol.MaxLineBytes);
+    }
+
+    static bool Parse(string json, out OracleRequest? request, out byte[]? error) =>
+        OracleProtocol.TryParse(Encoding.UTF8.GetBytes(json), out request, out error);
+}
diff --git a/tests/Meitou.Tests/Oracle/OracleServerTests.cs b/tests/Meitou.Tests/Oracle/OracleServerTests.cs
new file mode 100644
index 00000000..d822dfc1
--- /dev/null
+++ b/tests/Meitou.Tests/Oracle/OracleServerTests.cs
@@ -0,0 +1,226 @@
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Text.Json;
+using Meitou.Game.Oracle;
+
+namespace Meitou.Tests.Oracle;
+
+public class OracleServerTests
+{
+    static readonly TimeSpan Deadline = TimeSpan.FromSeconds(10);
+
+    [Fact]
+    public async Task Multiple_lines_are_dispatched_by_the_fake_host_and_keep_their_ids()
+    {
+        using var server = new OracleServer(0);
+        using var client = await Connect(server);
+        using var stream = client.GetStream();
+        await Send(stream, Request("one", "get_clock") + Request("two", "unknown_command"));
+        var first = await Dequeue(server);
+        Assert.Equal("get_clock", first.Command);
+        first.Complete(new { elapsed_seconds = 86400, paused = true });
+        using var one = await Read(stream);
+        Assert.Equal("one", one.RootElement.GetProperty("id").GetString());
+        Assert.Equal(86400, one.RootElement.GetProperty("result").GetProperty("elapsed_seconds").GetInt32());
+        var second = await Dequeue(server);
+        Assert.Equal("unknown_command", second.Command);
+        second.Fail("not_implemented", "No such host command.");
+        using var two = await Read(stream);
+        Assert.Equal("two", two.RootElement.GetProperty("id").GetString());
+        Assert.Equal("not_implemented", Code(two));
+        Assert.False(server.TryDequeue(out _));
+    }
+
+    [Fact]
+    public async Task Heartbeat_is_an_immediate_frozen_copy_while_a_host_command_waits()
+    {
+        using var server = new OracleServer(0);
+        var published = new Dictionary<string, object> { ["frame"] = 7, ["timestamp_ms"] = 123, ["loading"] = true };
+        server.PublishHeartbeat(published);
+        published["frame"] = 999;
+        published["timestamp_ms"] = 999;
+        using var waiting = await Connect(server);
+        using var waitingStream = waiting.GetStream();
+        await Send(waitingStream, Request("load", "load_save"));
+        var load = await Dequeue(server); // Fake host deliberately does not complete the load yet.
+        using var monitor = await Connect(server);
+        using var stream = monitor.GetStream();
+        for (int i = 0; i < 2; i++)
+        {
+            await Send(stream, Request("beat", "heartbeat"));
+            using var reply = await Read(stream);
+            Assert.Equal("beat", reply.RootElement.GetProperty("id").GetString());
+            var result = reply.RootElement.GetProperty("result");
+            Assert.Equal(7, result.GetProperty("frame").GetInt32());
+            Assert.Equal(123, result.GetProperty("timestamp_ms").GetInt32());
+            Assert.True(result.GetProperty("loading").GetBoolean());
+            Assert.False(server.TryDequeue(out _));
+        }
+        load.Complete(new { loaded = true });
+        using var loaded = await Read(waitingStream);
+        Assert.True(loaded.RootElement.GetProperty("result").GetProperty("loaded").GetBoolean());
+        await Send(stream, """{"id":"bad","command":"heartbeat","params":{"extra":1}}""" + "\n");
+        using var bad = await Read(stream);
+        Assert.Equal("invalid_request", Code(bad));
+    }
+
+    [Fact]
+    public async Task Malformed_lines_never_reach_the_host_and_the_next_line_still_works()
+    {
+        using var server = new OracleServer(0);
+        using var client = await Connect(server);
+        using var stream = client.GetStream();
+        await Send(stream, "not json\n" + Request("good", "get_clock"));
+        using var bad = await Read(stream);
+        Assert.Equal(JsonValueKind.Null, bad.RootElement.GetProperty("id").ValueKind);
+        Assert.Equal("invalid_request", Code(bad));
+        var good = await Dequeue(server);
+        Assert.Equal("good", good.Id.GetString());
+        good.Complete(null);
+        using var reply = await Read(stream);
+        Assert.Equal(JsonValueKind.Null, reply.RootElement.GetProperty("result").ValueKind);
+    }
+
+    [Fact]
+    public async Task An_overlong_line_is_bounded_and_cannot_hide_a_following_mutation()
+    {
+        using var server = new OracleServer(0);
+        using var client = await Connect(server);
+        using var stream = client.GetStream();
+        await Send(stream, new string('x', OracleProtocol.MaxLineBytes) + "\n" + Request("hidden", "pause"));
+        using var error = await Read(stream);
+        Assert.Equal("invalid_request", Code(error));
+        Assert.False(server.TryDequeue(out _));
+    }
+
+    [Fact]
+    public async Task A_host_timeout_cancels_queued_work_and_late_completion_cannot_replace_the_error()
+    {
+        using var server = new OracleServer(0, TimeSpan.FromSeconds(1), Deadline);
+        using var client = await Connect(server);
+        using var stream = client.GetStream();
+        await Send(stream, Request("pending", "pause"));
+        using var error = await Read(stream);
+        Assert.Equal("timeout", Code(error));
+        Assert.Contains("may already have started", error.RootElement.GetProperty("error").GetProperty("message").GetString());
+        Assert.False(server.TryDequeue(out _));
+
+        await Send(stream, Request("taken", "pause"));
+        var taken = await Dequeue(server);
+        using var takenError = await Read(stream);
+        Assert.Equal("timeout", Code(takenError));
+        Assert.True(taken.IsCancelled);
+        taken.Complete(new { paused = true });
+        using var unchanged = JsonDocument.Parse(await taken.Response);
+        Assert.Equal("timeout", Code(unchanged));
+    }
+
+    [Fact]
+    public async Task Disconnect_cancels_taken_work_and_disposal_releases_idle_sockets_and_port()
+    {
+        using var server = new OracleServer(0);
+        int port = server.LocalPort;
+        using var client = await Connect(server);
+        await Send(client.GetStream(), Request("gone", "pause"));
+        var request = await Dequeue(server);
+        client.Dispose();
+        await Until(() => request.IsCancelled);
+        using var idle = await Connect(server);
+        server.Dispose();
+        server.Dispose();
+        Assert.False(server.TryDequeue(out _));
+        using var replacement = new OracleServer(port);
+        Assert.Equal(port, replacement.LocalPort);
+    }
+
+    [Fact]
+    public async Task Queue_capacity_is_enforced_without_blocking_heartbeat()
+    {
+        using var server = new OracleServer(0, TimeSpan.FromSeconds(30), Deadline);
+        var clients = new List<TcpClient>();
+        var responses = new List<Task<JsonDocument>>();
+        try
+        {
+            for (int i = 0; i <= OracleProtocol.QueueCapacity; i++)
+            {
+                var client = await Connect(server);
+                clients.Add(client);
+                await Send(client.GetStream(), Request($"queued-{i}", "pause"));
+                responses.Add(Read(client.GetStream()));
+            }
+            var completed = await Task.WhenAny(responses).WaitAsync(Deadline, TestContext.Current.CancellationToken);
+            using var busy = await completed;
+            Assert.Equal("busy", Code(busy));
+            using var monitor = await Connect(server);
+            await Send(monitor.GetStream(), Request("monitor", "heartbeat"));
+            using var heartbeat = await Read(monitor.GetStream());
+            Assert.True(heartbeat.RootElement.TryGetProperty("result", out _));
+        }
+        finally
+        {
+            foreach (var client in clients) client.Dispose();
+            foreach (var response in responses)
+                try { (await response).Dispose(); }
+                catch (Exception ex) when (ex is IOException or SocketException or ObjectDisposedException or OperationCanceledException) { }
+        }
+    }
+
+    [Fact]
+    public async Task Idle_and_unterminated_clients_cannot_retain_commands()
+    {
+        using var server = new OracleServer(0, Deadline, TimeSpan.FromMilliseconds(100));
+        using var client = await Connect(server);
+        using var stream = client.GetStream();
+        await Send(stream, """{"id":"partial","command":"pause","params":{}}""");
+        var read = new byte[1];
+        int count = await stream.ReadAsync(read, TestContext.Current.CancellationToken).AsTask().WaitAsync(Deadline, TestContext.Current.CancellationToken);
+        Assert.Equal(0, count);
+        Assert.False(server.TryDequeue(out _));
+    }
+
+    static string Request(string id, string command) => JsonSerializer.Serialize(new { id, command, @params = new { } }) + "\n";
+    static string? Code(JsonDocument response) => response.RootElement.GetProperty("error").GetProperty("code").GetString();
+
+    static async Task<TcpClient> Connect(OracleServer server)
+    {
+        Assert.NotEqual(47800, server.LocalPort);
+        Assert.NotEqual(47801, server.LocalPort);
+        var client = new TcpClient(AddressFamily.InterNetwork);
+        await client.ConnectAsync(IPAddress.Loopback, server.LocalPort, TestContext.Current.CancellationToken);
+        Assert.Equal(IPAddress.Loopback, ((IPEndPoint)client.Client.RemoteEndPoint!).Address);
+        return client;
+    }
+
+    static async Task Send(NetworkStream stream, string text) =>
+        await stream.WriteAsync(Encoding.UTF8.GetBytes(text), TestContext.Current.CancellationToken);
+
+    static async Task<JsonDocument> Read(NetworkStream stream)
+    {
+        using var deadline = CancellationTokenSource.CreateLinkedTokenSource(TestContext.Current.CancellationToken);
+        deadline.CancelAfter(Deadline);
+        using var bytes = new MemoryStream();
+        var one = new byte[1];
+        while (await stream.ReadAsync(one, deadline.Token) != 0)
+        {
+            bytes.WriteByte(one[0]);
+            Assert.True(bytes.Length <= OracleProtocol.MaxLineBytes);
+            if (one[0] == '\n') return JsonDocument.Parse(bytes.ToArray());
+        }
+        throw new IOException("Oracle closed before returning a complete response line.");
+    }
+
+    static async Task<OracleRequest> Dequeue(OracleServer server)
+    {
+        OracleRequest? request = null;
+        await Until(() => server.TryDequeue(out request));
+        return request!;
+    }
+
+    static async Task Until(Func<bool> condition)
+    {
+        using var deadline = CancellationTokenSource.CreateLinkedTokenSource(TestContext.Current.CancellationToken);
+        deadline.CancelAfter(Deadline);
+        while (!condition()) await Task.Delay(10, deadline.Token);
+    }
+}
diff --git a/tests/Meitou.Tests/Oracle/OracleStateTests.cs b/tests/Meitou.Tests/Oracle/OracleStateTests.cs
new file mode 100644
index 00000000..aa8631e5
--- /dev/null
+++ b/tests/Meitou.Tests/Oracle/OracleStateTests.cs
@@ -0,0 +1,133 @@
+using System.Numerics;
+using System.Text.Json;
+using Meitou.Data;
+using Meitou.Data.Fcs;
+using Meitou.Data.Gameplay;
+using Meitou.Data.Gameplay.Bodies;
+using Meitou.Data.Save;
+using Meitou.Engine;
+using Meitou.Engine.Time;
+using Meitou.Game.Oracle;
+using Meitou.Simulation;
+using Meitou.Simulation.Bodies;
+using Meitou.Simulation.Saving;
+
+namespace Meitou.Tests.Oracle;
+
+public class OracleStateTests
+{
+    static WorldSession Session() => new(Vector3.Zero, (-100, -100, 100, 100), (_, _) => 0,
+        clock: new GameClock(12.5, 2));
+
+    static PopulationData Data()
+    {
+        FactionData[] factions = [new() { Id = "b", Name = "Second" }, new() { Id = "a", Name = "First" }];
+        var relations = FactionRelations.Build(factions);
+        relations.Set(0, 1, -31); relations.Set(1, 0, 42);
+        return new PopulationData { Db = new GameDatabase(), Sites = [], Factions = factions, Relations = relations };
+    }
+
+    static SavedCharacterLink Saved(int serial = 17)
+    {
+        var platoon = new SavePlatoon(new FcsRecord { StringId = "fixture-platoon" }, null);
+        platoon.Handle = new Hand(34, 7, 8, 0, 9);
+        var character = new SaveCharacter(platoon, new FcsInstance()) { GameState = new FcsRecord() };
+        character.Handle = new Hand(1, 7, 8, 10, serial);
+        return new SavedCharacterLink { Source = character, PlatoonName = platoon.Name, Slot = 10 };
+    }
+
+    [Fact]
+    public void Full_saved_hand_uses_all_unsigned_component_bits()
+    {
+        Assert.Equal("hand:1:4294967295:2147483648:2147483647:4294967294",
+            OracleState.SavedHandId(new Hand(1, -1, int.MinValue, int.MaxValue, -2)));
+        Assert.NotEqual(OracleState.SavedHandId(new Hand(1, 1, 2, 3, 4)), OracleState.SavedHandId(new Hand(1, 1, 9, 3, 4)));
+    }
+
+    [Fact]
+    public void Projection_preserves_saved_identity_and_known_health_without_inventing_unknowns()
+    {
+        using var session = Session();
+        var saved = Saved();
+        var medical = new MedicalState([new HealthPart(new BodyPartTemplate { StringId = "fixture-head" }, 1, 100)
+            { Flesh = -13, Stun = 8 }]);
+        var cold = new CharacterCold { Name = "Own synthetic hero", Save = saved, SquadId = 4, Faction = 0, Medical = medical };
+        var id = session.World.Characters.Spawn(new CharacterHot { Position = new Vector3(1, 2, 3) }, cold, 0);
+        var squad = new Squad { Id = 4, TemplateId = "fixture-template", SaveName = saved.Source.Platoon.Name, Faction = 0, Leader = id };
+        squad.Members.Add(id); session.World.Squads.Add(squad);
+        var projection = new OracleState();
+        long tick = session.World.Tick;
+        var state = projection.Capture(session, Data());
+        var row = state["characters"]![0]!;
+        Assert.Equal("hand:1:7:8:10:17", row["id"]!.GetValue<string>());
+        Assert.Equal("saved", row["identity_origin"]!.GetValue<string>());
+        Assert.Equal("saved", state["squads"]![0]!["identity_origin"]!.GetValue<string>());
+        Assert.Equal("hand:34:7:8:0:9", row["squad_id"]!.GetValue<string>());
+        Assert.Equal(-13, row["health"]![0]!["current"]!.GetValue<double>());
+        Assert.Null(row["health"]![0]!["maximum"]);
+        Assert.Null(row["in_combat"]); Assert.Null(row["current_town_id"]); Assert.Null(row["town_assignment"]); Assert.Null(row["order"]);
+        Assert.True(projection.TryResolveCharacter(row["id"]!.GetValue<string>(), out var resolved)); Assert.Equal(id, resolved);
+        Assert.Equal(row["id"]!.GetValue<string>(), projection.CharacterIdentity(id));
+        Assert.True(projection.TryResolveSquad("hand:34:7:8:0:9", out int squadId)); Assert.Equal(4, squadId);
+        Assert.Equal(tick, session.World.Tick);
+        // Recruitment can clear the mutable save link without changing an established identity.
+        cold.Save = null;
+        Assert.Equal("saved", projection.Capture(session, Data())["characters"]![0]!["identity_origin"]!.GetValue<string>());
+    }
+
+    [Fact]
+    public void Clock_is_absolute_calendar_seconds_and_relations_remain_directional()
+    {
