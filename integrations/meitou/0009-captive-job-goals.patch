 src/Meitou.Game/Oracle/OracleState.cs         | 17 +++--
 src/Meitou.Simulation/Kidnap/CaptiveSystem.cs |  4 ++
 tests/Meitou.Tests/Oracle/OracleStateTests.cs | 66 +++++++++++++++++++
 4 files changed, 86 insertions(+), 6 deletions(-)

