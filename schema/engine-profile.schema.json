{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kenshi-oracle:engine-profile:0.1",
  "title": "Kenshi oracle engine profile engine-profile-0.1",
  "description": "Local scene-setup pins per target, save, source fingerprint and seed (docs/scene-setup.md, Engine profile). The file is named by the config key engine_profile and is never committed. Pins exist for oracle-base-nature only; the loader enforces that and rejects duplicate lookup keys.",
  "type": "object", "additionalProperties": false,
  "required": ["profile_format", "entries"],
  "properties": {
    "profile_format": {"const": "engine-profile-0.1"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "coordinate": {"type": "number", "minimum": -10000000, "maximum": 10000000},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "save", "source_fingerprint", "seed", "player", "evidence"],
      "properties": {
        "target": {"enum": ["original", "meitou"]},
        "save": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f<>:\"/\\\\|?*]+$"},
        "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "seed": {
          "description": "null on the original; on MeitouClient null applies to every seed and a decimal-string seed entry takes precedence.",
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"}]
        },
        "player": {
          "type": "object", "additionalProperties": false,
          "required": ["xz", "y_before_settle", "y_after_settle", "decimals"],
          "properties": {
            "xz": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/coordinate"}},
            "y_before_settle": {"$ref": "#/$defs/coordinate"},
            "y_after_settle": {"$ref": "#/$defs/coordinate"},
            "decimals": {"type": "integer", "minimum": 0, "maximum": 6}
          }
        },
        "evidence": {"type": "string", "minLength": 1, "maxLength": 512, "description": "Relative path or run id of the local run that observed the pins."}
      },
      "if": {"properties": {"target": {"const": "original"}}},
      "then": {"properties": {"seed": {"type": "null"}}}
    }
  }
}
