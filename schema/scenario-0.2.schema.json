{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kenshi-oracle:scenario:0.2",
  "title": "Kenshi scenario format scenario-0.2",
  "description": "Scenario 0.1 plus an optional scene setup block (docs/scene-setup.md) and runner-resolved aliases in issue_order. The version is the distinct name scenario-0.2, never a bare 0.2, so it cannot be confused with state schema 0.2. Each repetition reloads save. Times are game calendar seconds (in-game hours x 3600) relative to the first paused state captured after that load and, with setup, after the setup block; one simulated second is 33 calendar seconds (see scenario.schema.json). At a shared time, actions execute in declared order before checkpoints. Semantic rules that JSON Schema cannot express (alias resolution, a != b, template counts, UTF-8 byte lengths) are checked by oracle_schema.validate_scenario.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "name", "save", "speed", "repeat", "actions", "checkpoints"],
  "properties": {
    "schema_version": {"const": "scenario-0.2"},
    "name": {"$ref": "#/$defs/safe_name"},
    "description": {"type": "string", "maxLength": 4096},
    "save": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f<>:\"/\\\\|?*]+$", "description": "Existing local save name, never a path. Save files are not included in the repository."},
    "speed": {"$ref": "#/$defs/speed"},
    "repeat": {"type": "integer", "minimum": 1, "maximum": 100},
    "setup": {"$ref": "#/$defs/setup"},
    "actions": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/action"}},
    "checkpoints": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/checkpoint"}}
  },
  "if": {"required": ["setup"]},
  "then": {"properties": {"speed": {"exclusiveMinimum": 0}}},
  "$defs": {
    "safe_name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "gamedata_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "description": "Exact GameData string id, at most 128 UTF-8 bytes (byte length checked by the validator)."},
    "spawn_alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$", "not": {"const": "player"}},
    "alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}(/[A-Za-z0-9][A-Za-z0-9._-]{0,127})*$", "description": "player, player/<n>, or <spawn alias>/<template>/<k>; resolution is checked by the validator."},
    "time": {"type": "number", "minimum": 0, "maximum": 1000000000},
    "speed": {"type": "number", "minimum": 0, "maximum": 5},
    "coordinate": {"type": "number", "minimum": -10000000, "maximum": 10000000},
    "position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/coordinate"}},
    "xz": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/coordinate"}},
    "relation_value": {"type": "integer", "minimum": -100, "maximum": 100},
    "checkpoint": {
      "type": "object", "additionalProperties": false, "required": ["at", "name"],
      "properties": {"at": {"$ref": "#/$defs/time"}, "name": {"$ref": "#/$defs/safe_name"}}
    },
    "setup": {
      "type": "object", "additionalProperties": false,
      "required": ["preflight", "moves", "spawns", "settle", "heal", "relations"],
      "properties": {
        "preflight": {
          "type": "object", "additionalProperties": false,
          "required": ["scene_center", "scene_radius", "squad_size_multiplier", "player_faction_id", "expect_absent_factions_in_scene"],
          "properties": {
            "scene_center": {"$ref": "#/$defs/xz"},
            "scene_radius": {"type": "number", "exclusiveMinimum": 0, "maximum": 20000},
            "squad_size_multiplier": {"const": 1},
            "player_faction_id": {"$ref": "#/$defs/gamedata_id"},
            "expect_absent_factions_in_scene": {"type": "array", "items": {"$ref": "#/$defs/gamedata_id"}}
          }
        },
        "moves": {"type": "array", "maxItems": 0},
        "spawns": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/spawn"}},
        "settle": {
          "type": "object", "additionalProperties": false, "required": ["sim_seconds"],
          "properties": {"sim_seconds": {"const": 1}}
        },
        "heal": {"const": "all_scene_characters"},
        "relations": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/relation"}}
      }
    },
    "spawn": {
      "type": "object", "additionalProperties": false,
      "required": ["alias", "squad_template", "count", "faction_id", "at", "expected_templates"],
      "properties": {
        "alias": {"$ref": "#/$defs/spawn_alias"},
        "squad_template": {"$ref": "#/$defs/gamedata_id"},
        "count": {"type": "integer", "minimum": 1, "maximum": 16},
        "faction_id": {"$ref": "#/$defs/gamedata_id"},
        "at": {
          "type": "object", "additionalProperties": false, "required": ["offset_from_player"],
          "properties": {"offset_from_player": {"$ref": "#/$defs/xz"}}
        },
        "expected_templates": {
          "type": "object", "minProperties": 1, "maxProperties": 16,
          "propertyNames": {"$ref": "#/$defs/gamedata_id"},
          "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 16}
        }
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false, "required": ["a", "b", "a_to_b", "b_to_a"],
      "properties": {
        "a": {"$ref": "#/$defs/gamedata_id"}, "b": {"$ref": "#/$defs/gamedata_id"},
        "a_to_b": {"$ref": "#/$defs/relation_value"}, "b_to_a": {"$ref": "#/$defs/relation_value"}
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["at", "command", "params"],
          "properties": {
            "at": {"$ref": "#/$defs/time"}, "command": {"const": "pause"},
            "params": {"type": "object", "additionalProperties": false, "required": ["paused"], "properties": {"paused": {"type": "boolean"}}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["at", "command", "params"],
          "properties": {
            "at": {"$ref": "#/$defs/time"}, "command": {"const": "set_game_speed"},
            "params": {"type": "object", "additionalProperties": false, "required": ["speed"], "properties": {"speed": {"$ref": "#/$defs/speed"}}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["at", "command", "params"],
          "properties": {
            "at": {"$ref": "#/$defs/time"}, "command": {"const": "issue_order"},
            "params": {"$ref": "#/$defs/issue_order"}
          }
        }
      ]
    },
    "issue_order": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["move", "attack"]},
        "character_id": {"$ref": "#/$defs/id"}, "squad_id": {"$ref": "#/$defs/id"},
        "character_alias": {"$ref": "#/$defs/alias"}, "squad_alias": {"$ref": "#/$defs/spawn_alias"},
        "position": {"$ref": "#/$defs/position"},
        "target_id": {"$ref": "#/$defs/id"}, "target_alias": {"$ref": "#/$defs/alias"}
      },
      "oneOf": [{"required": ["character_id"]}, {"required": ["squad_id"]}, {"required": ["character_alias"]}, {"required": ["squad_alias"]}],
      "allOf": [
        {"if": {"properties": {"type": {"const": "move"}}}, "then": {"required": ["position"], "not": {"anyOf": [{"required": ["target_id"]}, {"required": ["target_alias"]}]}}},
        {"if": {"properties": {"type": {"const": "attack"}}}, "then": {"oneOf": [{"required": ["target_id"]}, {"required": ["target_alias"]}], "not": {"required": ["position"]}}}
      ]
    }
  }
}
